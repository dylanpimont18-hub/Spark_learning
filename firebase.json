{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "docs/**",
      "scripts/**",
      "CLAUDE.md",
      "CODEBASE_MAP.md",
      "README.md",
      "contenu.md",
      "package.json",
      "package-lock.json",
      "firestore.rules",
      "storage.rules",
      "CNAME"
    ],
    "rewrites": [
      {
        "regex": "^/([^m].*|m([^e].*)?|me([^d].*)?|med([^i].*)?|medi([^a].*)?|media([^/].*)?)?$",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/media/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "/media/**/*.rvt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/octet-stream"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment"
          }
        ]
      }
    ]
  }
}
