{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "devoir",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "test"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": {
    "public": ".",
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "docs/**",
      "scripts/**",
      "functions/**",
      "CLAUDE.md",
      "CODEBASE_MAP.md",
      "README.md",
      "QUESTIONS.md",
      "contenu.md",
      "package.json",
      "package-lock.json",
      "firestore.rules",
      "storage.rules",
      "CNAME"
    ],
    "rewrites": [
      {
        "source": "/devoirs",
        "destination": "/devoir.html"
      },
      {
        "source": "/devoir",
        "destination": "/devoir.html"
      },
      {
        "regex": "^/([^m].*|m([^e].*)?|me([^d].*)?|med([^i].*)?|medi([^a].*)?|media([^/].*)?)?$",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/media/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "/media/**/*.@(rvt|rfa)",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/octet-stream"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "hosting": {
      "port": 5055
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
