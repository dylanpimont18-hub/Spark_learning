{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "docs/**",
      "scripts/**",
      "communication/**",
      "LinkedIn/**",
      "CLAUDE.md",
      "CODEBASE_MAP.md",
      "README.md",
      "contenu.md",
      "firestore.rules",
      "storage.rules",
      "CNAME"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
