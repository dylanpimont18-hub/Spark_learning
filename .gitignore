.superpowers/
communication/
.venv/
*.log
.firebase/
node_modules/
# Sorties de scripts/prerender.js : un dossier <route>/index.html par URL du sitemap.
# Cette liste doit couvrir tous les préfixes de route émis par scripts/generate-sitemap.js
# (/, /subjects, /contact, /confidentialite, /levels/*, /modules/*, /module/*) — en ajouter une
# nouvelle classe là-bas impose d'ajouter la ligne correspondante ici, sinon le pré-rendu
# lancé en local laisse des fichiers non ignorés dans le dépôt.
# ('/' écrit dans index.html, fichier suivi : le script prévient bruyamment.)
/module/
/modules/
/levels/
/subjects/
/contact/
/confidentialite/
/scripts/fixtures/

# Manuels generes : PDF volumineux et figures intermediaires.
# Couverture 100% TikZ (ouvrage.js) : aucune image a versionner.
Manuel scolaire/**
!Manuel scolaire/*/

# Theme Shopify de la boutique (Liquid) : pull local via Shopify CLI, projet
# distinct du site vanilla JS, ne doit jamais etre commite dans ce depot.
Shopify/

# Sortie du skill /graphify (graphe de connaissances local, regenerable).
graphify-out/

# Pipeline TikTok (tiktok/) : le code est versionne, ses sorties non.
# - catalogue.json est un derive de js/data/, regenerable par
#   `node tiktok/tools/export-modules.js` (1,9 Mo qui changeraient a
#   chaque ajout de module).
# - .travail/ contient les trames de capture et l'audio intermediaire.
tiktok/output/
tiktok/output-culture/
# Videos de presentation rendues : regenerables par interview.py, et 10 Mo
# dans l'historique Git ne se desallouent jamais.
tiktok/output-interview/
tiktok/.travail/
tiktok/catalogue.json
# Memoire de production : etat local de la machine qui rend. La perdre
# ne casse rien, mais oblige a refabriquer les videos deja faites.
tiktok/production.json
tiktok/sujets.json
tiktok/envois.json
tiktok/.env
__pycache__/
*.pyc
