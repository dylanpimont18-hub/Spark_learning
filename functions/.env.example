# Réglages des Cloud Functions du module devoir. Copier ce fichier en « .env » (non versionné)
# pour changer une valeur, puis redéployer les fonctions. Aucun secret ici : la clé de l'API
# Anthropic se règle par « firebase functions:secrets:set ANTHROPIC_API_KEY ».

# Modèle utilisé par la pré-correction (runPreCorrection).
DEVOIR_MODELE_IA=claude-sonnet-5-5

# Garde-fou de dépense : nombre maximal d'appels au modèle par jour (un appel par exercice rendu).
DEVOIR_IA_APPELS_MAX_PAR_JOUR=300
