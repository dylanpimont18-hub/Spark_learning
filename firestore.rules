rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && getUserData().role == 'admin';
    }

    // ─── users ───
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Plus d'auto-inscription (retirée de l'interface le 2026-10-12) : un profil n'est créé
      // que par un admin, ou depuis la console Firebase qui contourne ces règles. Sans ce
      // verrou, n'importe qui pouvait encore se créer un compte via l'API Firebase Auth
      // puis écrire lui-même son document users/{uid} en contournant l'interface.
      allow create: if isAdmin();

      allow update: if isAdmin() || (isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'approvedAt', 'approvedBy']));
    }

    // ─── config (annonce globale, mode maintenance, verrouillage des modules) ───
    // Lecture publique (nécessaire pour vérifier le mode maintenance côté invité, avant connexion)
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── adminLogs ───
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── Module devoir en classe (docs/evaluation/) ───
    // Classes (listes de noms, profil Dys) et banque d'exercices (formules du corrigé) : admin
    // seul. Les étudiants n'y accèdent jamais ; les sessions (MVP-2) auront leurs propres règles.
    match /devoir_classes/{classeId} {
      allow read, write: if isAdmin();
    }
    match /devoir_exercices/{exerciceId} {
      allow read, write: if isAdmin();
    }

    // Passage en classe (MVP-2 à 4). Toutes les écritures passent par les Cloud Functions
    // (functions/, SDK admin, qui contourne ces règles) : aucun client n'écrit ici, pas même
    // l'enseignant. L'étudiant (connexion anonyme) ne lit qu'un seul document : sa propre copie,
    // qui ne contient ni corrigé, ni barème, ni note.
    match /devoir_sessions/{sessionId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /devoir_copies/{copieId} {
      // La condition « propriétaire » est placée en premier : pour un étudiant anonyme,
      // isAdmin() échoue (pas de profil users/{uid}).
      allow get: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }
    // Valeurs tirées, corrigé calculé, barème, historique de brouillon.
    match /devoir_copies_prive/{copieId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Journal en ajout seul, écrit par le serveur.
    match /devoir_evenements/{evenementId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Pré-corrections de l'IA, corrections de l'enseignant, notes.
    match /devoir_corrections/{correctionId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // devoir_codes, devoir_tentatives, devoir_historique : aucune règle, donc aucun accès client.

    // Les collections classes, progress et assignments (espace enseignant, retiré le
    // 2026-11-22) ne sont plus accessibles : tout ce qui n'est pas listé ici est refusé.
  }
}
