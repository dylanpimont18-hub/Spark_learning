# Copier ce fichier en .env (le COPIER, pas le renommer : ce modele doit
# rester dans le depot) et renseigner la cle.
# .env est ignore par git : il ne doit jamais etre commite.

# Cle API Mammouth (Parametres du compte > API sur mammouth.ai)
MAMMOUTH_API_KEY=

# Endpoint compatible OpenAI. A ne changer que si Mammouth le modifie.
MAMMOUTH_BASE_URL=https://api.mammouth.ai/v1

# Modele utilise pour ecrire les scripts.
# "mammouth-recommended" est l'alias maison vers le meilleur rapport
# qualite/prix du moment. Alternatives economiques du catalogue :
# gpt-5.4-mini, gemini-3.1-flash, mistral-small, claude-haiku.
MAMMOUTH_MODELE=mammouth-recommended

# Nom de la mascotte a l'ecran et dans les scripts.
MASCOTTE=Sparky

# Site filme en arriere-plan. Mettre http://localhost:5000 pour
# capturer une version locale non deployee.
SITE_URL=https://sparklearning.fr

# Dossier synchronise par Google Drive pour ordinateur. Laisser vide
# pour une detection automatique (G:/Mon Drive, ~/Mon Drive...).
# Les videos y sont copiees apres rendu, pour publication manuelle
# depuis le telephone. Si Drive est absent, le rendu se poursuit et le
# depot est simplement signale comme non effectue.
DOSSIER_DRIVE=
DOSSIER_DRIVE_CIBLE=TikTok Spark Learning
